import cv2 as cv
import numpy as np

# Load billeder
img_board = cv.imread('MiniProjekt/Boards/15.jpg')
img_board_gray = cv.cvtColor(img_board, cv.COLOR_BGR2GRAY)
crown_template = cv.imread('MiniProjekt/Templates/Template_4_small.jpg', cv.IMREAD_GRAYSCALE)

h, w = crown_template.shape

# Generer de 4 roterede templates
rotations = [crown_template, cv.rotate(crown_template, cv.ROTATE_90_CLOCKWISE),
             cv.rotate(crown_template, cv.ROTATE_180), cv.rotate(crown_template, cv.ROTATE_90_COUNTERCLOCKWISE)]

# Match og find lokationer for alle 4 vinkler på én linje
threshold = 0.56
saved_locations = [np.where(cv.matchTemplate(img_board_gray, i, cv.TM_CCOEFF_NORMED) >= threshold) for i in rotations]

#definerer crown count og to arrays til at gemme lokationer som der allerede er optegnet
count = 0
locations_used_real = []

# main kode til at tegne bounding box
for x in range(4):
    for pt in zip(*saved_locations[x][::-1]):
        #Tjekker om de rigtige koordinater ligger for tæt på en eksisterende bounding box
        is_too_close = False
        for saved_point in locations_used_real:
            real_x = saved_point[0]  # Her definerer vi real_x 
            real_y = saved_point[1]  # Her definerer vi real_y
            
            # Tjek om både x og y er inden for +-5 pixels
            if abs(real_x - pt[0]) <= 5 and abs(real_y - pt[1]) <= 5:
                is_too_close = True
                break  # Vi har fundet et punkt der var for tæt på, så vi behøver ikke kigge videre

        #Hvis den ikke ligger for tæt på, bliver der tegnet en ny bounding box
        if is_too_close:
            continue
        else:
            locations_used_real.append([int(pt[0]), int(pt[1])])
            if x % 2 == 0:
                cv.rectangle(img_board, pt, (pt[0] + w, pt[1] + h), (0,255,0), 1)
                count += 1
            else:
                cv.rectangle(img_board, pt, (pt[0] + h, pt[1] + w), (0,255,0), 1)
                count += 1



#konverterer koordinater til 5x5 grid
used_locations_5x5 = []
for x in locations_used_real:
    loc_x = int(x[0]/100)
    loc_y = int(x[1]/100)
    used_locations_5x5.append([loc_x, loc_y])

#Printer antal kroner, koordinaterne og viser boardet med bounding boxes
print("antal kroner: ", count)
print("5x5 grid koordinater: ", used_locations_5x5)
print("rigtige koordinater: ", locations_used_real)
cv.imshow('template_match', img_board)
cv.waitKey(0)
cv.destroyAllWindows()
