import cv2 as cv
import numpy as np
 
img_board = cv.imread('MiniProjekt/Boards/20.jpg')
assert img_board is not None, "file could not be read, check with os.path.exists()"
img_gray_board = cv.cvtColor(img_board, cv.COLOR_BGR2GRAY)

crown_template_0 = cv.imread('MiniProjekt/Templates/Template_4_small.jpg', cv.IMREAD_GRAYSCALE)
crown_template_90 = cv.rotate(crown_template_0, cv.ROTATE_90_CLOCKWISE)
crown_template_180 = cv.rotate(crown_template_90, cv.ROTATE_90_CLOCKWISE)
crown_template_270 = cv.rotate(crown_template_180, cv.ROTATE_90_CLOCKWISE)

assert crown_template_0 is not None, "file could not be read, check with os.path.exists()"
w, h = crown_template_0.shape[::-1]

result_0 = cv.matchTemplate(img_gray_board,crown_template_0,cv.TM_CCOEFF_NORMED)
result_90 = cv.matchTemplate(img_gray_board,crown_template_90,cv.TM_CCOEFF_NORMED)
result_180 = cv.matchTemplate(img_gray_board,crown_template_180,cv.TM_CCOEFF_NORMED)
result_270 = cv.matchTemplate(img_gray_board,crown_template_270,cv.TM_CCOEFF_NORMED)

threshold = 0.56
saved_locations_0 = np.where(result_0 >= threshold)
saved_locations_90 = np.where(result_90 >= threshold)
saved_locations_180 = np.where(result_180 >= threshold)
saved_locations_270 = np.where(result_270 >= threshold)

count = 0
locations_used_real = []
locations_used = []
for pt in zip(*saved_locations_0[::-1]):
    if [round(pt[0]/20)*20, round(pt[1]/20)*20] in locations_used:
        continue

    is_too_close = False
    for saved_point in locations_used_real:
        real_x = saved_point[0]  # Her definerer vi real_x
        real_y = saved_point[1]  # Her definerer vi real_y
        
        # Tjek om både x og y er inden for +-5 pixels
        if abs(real_x - pt[0]) <= 5 and abs(real_y - pt[1]) <= 5:
            is_too_close = True
            break  # Vi har fundet et punkt der var for tæt på, så vi behøver ikke kigge videre

    if is_too_close:
        continue
    else:
        locations_used.append([round(pt[0]/20)*20, round(pt[1]/20)*20])
        locations_used_real.append([int(pt[0]), int(pt[1])])
        cv.rectangle(img_board, pt, (pt[0] + w, pt[1] + h), (0,255,0), 1)
        count += 1

