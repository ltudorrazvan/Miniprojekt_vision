import cv2
import numpy as np 

img = cv2.imread('Træningsdata/15.jpg')

def deleteMaskFromImage(mask, image):
    h,w, _ = image.shape
    for row in range(h):
        for col in range(w):
            if mask[col,row] == 255:
                image[col,row] = 0
            else:
                continue
                

if img is None:
    print("Fejl: Billedet kunne ikke indlæses. Tjek at filstien er korrekt.")
else:
    # 1. Skaler billedet ned til 5x5 pixels
    img_5x5 = cv2.resize(img, (5, 5), interpolation=cv2.INTER_AREA)

    # 2. Skaler det op til 500x500 pixels med skarpe kanter (INTER_NEAREST)
    img_500 = cv2.resize(img_5x5, (500, 500), interpolation=cv2.INTER_NEAREST)

    # 3. Konverter det opskalerede billede til HSV
    hsv_img = cv2.cvtColor(img_500, cv2.COLOR_BGR2HSV)


    # _____________Water___________________________________________________
    lower_water = np.array([100, 111, 90])
    upper_water = np.array([110, 255, 190])

    mask_water = cv2.inRange(hsv_img, lower_water, upper_water)
    # Brug img_500 her i stedet for img_5x5:
    res_water = cv2.bitwise_and(img_500, img_500, mask=mask_water)


    deleteMaskFromImage(mask_water,hsv_img)


    # __________________GRASS___________________________________________
    lower_grass = np.array([31, 157, 93])
    upper_grass = np.array([45, 226, 157])

    mask_grass = cv2.inRange(hsv_img, lower_grass, upper_grass)
    res_grass = cv2.bitwise_and(img_500, img_500, mask=mask_grass)

    deleteMaskFromImage(mask_grass,hsv_img)

    # ____________________________FOREST_____________________________________
    lower_forest = np.array([29, 91, 38])
    upper_forest = np.array([50, 199, 80])

    mask_forest = cv2.inRange(hsv_img, lower_forest, upper_forest)
    res_forest = cv2.bitwise_and(img_500, img_500, mask=mask_forest)

    deleteMaskFromImage(mask_forest,hsv_img)

    # ____________________FIELD____________________________________________________
    lower_field = np.array([23, 118, 142])
    upper_field = np.array([28, 255, 201])

    mask_field = cv2.inRange(hsv_img, lower_field, upper_field)
    res_field = cv2.bitwise_and(img_500, img_500, mask=mask_field)

    deleteMaskFromImage(mask_field,hsv_img)

    # ______________________________DESERT___________________________________________
    lower_desert = np.array([19, 55, 75])
    upper_desert = np.array([28, 163, 131])

    mask_desert = cv2.inRange(hsv_img, lower_desert, upper_desert)
    res_desert = cv2.bitwise_and(img_500, img_500, mask=mask_desert)

    deleteMaskFromImage(mask_desert,hsv_img)

    # _______________________MINES____________________________________________________________
    lower_mine = np.array([18, 90, 50])
    upper_mine = np.array([24, 165, 91])

    mask_mine = cv2.inRange(hsv_img, lower_mine, upper_mine)
    res_mine = cv2.bitwise_and(img_500, img_500, mask=mask_mine)

    deleteMaskFromImage(mask_mine,hsv_img)

    # Vis resultaterne (alle er nu 500x500 pixels)

    cv2.imshow('Mask_forest', mask_forest)
    cv2.imshow('HSV', hsv_img)
    cv2.imshow('image', img)
    
